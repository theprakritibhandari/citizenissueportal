{
  "name": "citizen-issue-reporting-portal",
  "private": true,
  "version": "1.0.0",
  "description": "Full-stack Citizen Issue Reporting Portal with React, Express, and MongoDB",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "seed:server": "npm --prefix server run seed",
    "set-admin": "node ./server/utils/manageAdmin.js"
  },
  "keywords": [
    "citizen",
    "issues",
    "grievance",
    "reporting",
    "portal",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
