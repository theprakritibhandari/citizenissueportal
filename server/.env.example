# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/citizen_portal
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/citizen_portal?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets
# Provide a strong, random secret key for signing JWTs
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL in production - e.g. https://your-app.vercel.app or comma-separated)
CLIENT_URL=http://localhost:5173

# Municipal Administrator Initialization / Sync (Optional)
# If provided in production, the server will ensure this admin user exists and synchronize its password on startup
ADMIN_EMAIL=admin@municipality.gov
ADMIN_PASSWORD=
